DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=afaaqinstitute.com,www.afaaqinstitute.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://afaaqinstitute.com,https://www.afaaqinstitute.com
DJANGO_CORS_ALLOWED_ORIGINS=https://afaaqinstitute.com,https://www.afaaqinstitute.com
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
# Keep at 0 until HTTPS is externally verified, then set to 31536000.
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=afaaqinstitute
POSTGRES_USER=afaaqinstitute
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

DEFAULT_FROM_EMAIL="Afaaq Academy <afaaqinstitute@gmail.com>"
AFQ_NOTIFICATION_EMAIL=afaaqinstitute@gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=afaaqinstitute@gmail.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

TRIAL_REQUEST_RATE=8/hour
CONTACT_MESSAGE_RATE=12/hour
