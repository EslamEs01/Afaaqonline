[Unit]
Description=Daily Afaaq Institute PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/var/www/afaaqinstitute/deploy/backup/afaaqinstitute-backup.sh
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
NoNewPrivileges=true
